# =======================================================
# AI Content Transformer - Backend Environment Variables
# =======================================================

# Google Gemini API Key (Required for real AI transformation)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Set to "true" to test with mock responses without an API key
USE_MOCK=false

# Deployment & Security Configuration
# Comma-separated list of allowed origins (or "*" for development)
ALLOWED_ORIGINS=*

# API Rate Limiter (requests per minute per client IP, default: 60)
RATE_LIMIT_PER_MINUTE=60

# Maximum Allowed Request Payload Size in bytes (default: 35MB = 36700160)
MAX_REQUEST_BODY_SIZE_BYTES=36700160
